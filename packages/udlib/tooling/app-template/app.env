# TEMPLATE. Copy to <app>/app.env and fill in.
#
# This is the entire app-specific surface of the shared release
# tooling. If something here is not app-specific, it belongs in udlib
# instead.

# Artifact base name: builds come out as <APP_NAME>-<version>.apk/.aab.
APP_NAME=example

# Android applicationId. Passed to the Play upload script, which
# requires it rather than defaulting -- shared tooling must not make a
# wrong upload a typo away.
PACKAGE=com.unexpectedevelopments.example

# Play tracks that dev/publish-to-store.sh pushes to, in order.
TRACKS=(internal)

# Extra flutter build arguments, applied to both the APK and the .aab.
# Leave unset if there are none.
# BUILD_ARGS=(--dart-define=DISCOVERY=tiles)

# Pass the semver in as APP_VERSION. Only for apps that read their
# version at runtime from a --dart-define (coldsleep); the others keep
# a const in lib/core/version.dart and must NOT set this.
# VERSION_VIA_DART_DEFINE=1

# dart-define-from-file, relative to the repo root. Overridable per
# build from the environment (ENV_FILE=env/local.json dev/...).
# ENV_FILE=env/test.json

# Never reuse a bundle already built for this version; always rebuild
# before publishing. Default is 1 (reuse), which is what sanlo and
# coldsleep have always done. birradar sets 0, because reuse means
# editing code without bumping the version uploads the older bits.
# REUSE_AAB=0

# Where artifacts and symbol maps land. The defaults in udlib's lib.sh
# are right for all three apps; override only with a reason.
# APK_OUT_DIR=...
# AAB_OUT_DIR=...
# SYMBOLS_DIR=...

# Not set here but honoured per build: SUFFIX appends to the APK name,
# to keep variant builds apart.
#   SUFFIX=-tiles dev/build-android.sh --dart-define=DISCOVERY=tiles
